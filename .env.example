# Copy to .env and fill in real values. Never commit .env itself.

# PostgreSQL (docker-compose / local)
POSTGRES_DB=nspc
POSTGRES_USER=nspc
POSTGRES_PASSWORD=change_me

# JWT (backend + docker-compose)
JWT_SECRET=change_me_min_32_characters
JWT_ISSUER=NSPCBackend
JWT_AUDIENCE=NSPCAdmin

# Next.js auth (Admin + Frontend)
AUTH_SECRET=change_me
