# Copy to .env and fill in real values. Never commit .env itself.

# PostgreSQL (docker-compose / local)
POSTGRES_DB=nspc
POSTGRES_USER=nspc
POSTGRES_PASSWORD=change_me

# JWT (backend + docker-compose)
JWT_SECRET=change_me_min_32_characters
JWT_ISSUER=NSPCBackend
JWT_AUDIENCE=NSPCAdmin

# Next.js auth (Admin + Frontend)
AUTH_SECRET=change_me

# Email (SMTP)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your_email@gmail.com
EMAIL_SMTP_PASSWORD=your_app_password
EMAIL_FROM_NAME="NSPC CMS"
EMAIL_FROM_ADDRESS=your_email@gmail.com
EMAIL_REPLY_TO=support@nspc.local

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHANNEL_ID=@nspc2026
