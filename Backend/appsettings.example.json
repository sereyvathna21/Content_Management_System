{
  "Security": {
    "AllowedAdminIps": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=nspc;Username=nspc;Password=YOUR_DB_PASSWORD",
    "RedisConnection": "localhost:6379"
  },
  "Jwt": {
    "Secret": "YOUR_JWT_SECRET_MIN_32_CHARS",
    "Issuer": "NSPCBackend",
    "Audience": "NSPCAdmin",
    "ExpiryMinutes": 1440
  },
  "Email": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SmtpUser": "your-email@gmail.com",
    "SmtpPassword": "YOUR_SMTP_APP_PASSWORD",
    "FromName": "NSPC CMS",
    "FromAddress": "your-email@gmail.com",
    "ReplyTo": "support@nspc.local"
  },
  "App": {
    "ResetPasswordUrl": "http://localhost:3001",
    "AdminUrl": "http://localhost:3001",
    "FrontendUrl": "http://localhost:3000",
    "FrontendUrls": ["http://localhost:3000", "http://localhost:3001"],
    "OtpExpiryMinutes": 10,
    "TrustedProxyIps": []
  },
  "Notifications": {
    "RetentionDays": 30
  },
  "AuditLogs": {
    "RetentionDays": 365,
    "SecurityRetentionDays": 1095
  },
  "Telegram": {
    "BotToken": "YOUR_TELEGRAM_BOT_TOKEN",
    "ChannelId": "YOUR_TELEGRAM_CHANNEL_ID"
  },
   "Recaptcha": {
    "SecretKey": "YOUR_RECAPTCHA_SECRET_KEY"
  }
}
