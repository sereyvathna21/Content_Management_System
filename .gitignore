# NSPC CMS — root .gitignore (authoritative for the monorepo)

# macOS / Windows
**/.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Node / JavaScript
node_modules/
.pnp/
.pnp.js
.pnp.*
.yarn/install-state.gz
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Next.js / frontend build outputs
**/.next/
out/
build/
dist/
.turbo/
.cache/

# Vercel
.vercel/
.now/

# TypeScript (generated)
*.tsbuildinfo
next-env.d.ts

# Environment files — ignore secrets, allow example templates
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
.env.*
!.env.example
!**/.env.example

# Backend config / secrets (scoped to Backend/)
Backend/appsettings.json
Backend/appsettings.Development.json
Backend/appsettings.Local.json
Backend/secrets.json
!Backend/appsettings.example.json

# User-uploaded media (never commit)
Backend/wwwroot/uploads/
wwwroot/

# Logs
logs/
*.log

# Editor / IDE (local per developer)
.vscode/
.idea/
.cursor/
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.iml

# .NET build outputs
**/bin/
**/obj/
publish/
artifacts/

# NuGet
*.nupkg
.nuget/packages/

# Databases
*.db
*.sqlite
*.db-journal

# Coverage and testing
coverage/

# Certificates / keys
*.pem
